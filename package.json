{
  "name": "clonedzz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm run dev -w apps/server\" \"npm run dev -w apps/web\"",
    "dev:server": "npm run dev -w apps/server",
    "dev:web": "npm run dev -w apps/web",
    "analyze": "node packages/engine/src/cli.ts",
    "build": "npm run build -w apps/web",
    "desktop": "npm run start -w apps/desktop"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2"
  }
}
